# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Data: raw is never tracked (re-collect via scripts); small processed files are tracked
data/raw/*
!data/raw/.gitkeep
data/interim/
*.parquet
*.feather
*.pkl
# Synthetic-data runs are regenerable (`synergy estimate --synthetic`)
data/processed/synthetic/

# Papers: keep PDFs local (redistribution terms unclear); the folder stays via .gitkeep
docs/papers/*.pdf

# Outputs: generated tables and figures
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Secrets / local config
.env
.env.*
CLAUDE.local.md
